<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>logwatch report</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 2rem; background: #0f1419; color: #e6e6e6; }
  h1 { margin-bottom: .25rem; }
  .cards { display: flex; gap: 1rem; margin: 1.5rem 0; flex-wrap: wrap; }
  .card { background: #1a2129; padding: 1rem 1.5rem; border-radius: 8px; min-width: 110px; }
  .card .n { font-size: 2rem; font-weight: 700; }
  table { border-collapse: collapse; width: 100%; margin-bottom: 2rem; }
  th, td { text-align: left; padding: .5rem .75rem; border-bottom: 1px solid #2a323c; }
  th { color: #8b98a5; font-weight: 600; }
  .badge { padding: .15rem .6rem; border-radius: 4px; font-size: .8rem; font-weight: 700; color: #fff; }
  .critical { background: #c0392b; } .high { background: #e67e22; }
  .medium { background: #d4ac0d; color: #000; } .low { background: #2e86c1; }
  code { background: #1a2129; padding: .1rem .35rem; border-radius: 4px; }
</style>
</head>
<body>
<h1>logwatch report</h1>

<div class="cards">
  <div class="card"><div class="n">{{ summary.total }}</div>total alerts</div>
  {% for s in severities %}
  <div class="card"><div class="n">{{ summary.by_severity.get(s, 0) }}</div>{{ s }}</div>
  {% endfor %}
</div>

<h2>Alerts</h2>
<table>
  <tr><th>Severity</th><th>ATT&amp;CK</th><th>Rule</th><th>IP</th><th>Time (UTC)</th><th>Detail</th></tr>
  {% for a in alerts %}
  <tr>
    <td><span class="badge {{ a.severity }}">{{ a.severity | upper }}</span></td>
    <td>{{ a.attack_id }}</td>
    <td>{{ a.rule }}</td>
    <td><code>{{ a.ip }}</code></td>
    <td>{{ a.ts.strftime("%Y-%m-%d %H:%M:%S") }}</td>
    <td>{{ a.detail }}</td>
  </tr>
  {% else %}
  <tr><td colspan="6">No alerts.</td></tr>
  {% endfor %}
</table>

<h2>Top attacker IPs</h2>
<table>
  <tr><th>IP</th><th>Alerts</th></tr>
  {% for ip, n in summary.top_ips %}
  <tr><td><code>{{ ip }}</code></td><td>{{ n }}</td></tr>
  {% endfor %}
</table>
</body>
</html>